{
  "name": "bmall-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "bmall": "dist/cli.js"
  },
  "files": [
    "dist",
    "manifests",
    "docs/source-knowledge",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "tsx scripts/generate-command-docs.ts manifests/bmall.commands.json docs/command-reference.md"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "pino": "^9.6.0",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "tmp": "0.2.7",
      "exceljs@4.4.0>uuid": "11.1.1"
    }
  }
}
